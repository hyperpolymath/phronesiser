-- Idris2 package for the phronesiser ABI formal proofs.
-- Build/check with:  idris2 --build phronesiser-abi.ipkg   (from src/interface/abi/)
package phronesiser-abi

sourcedir = "."

modules = Phronesiser.ABI.Types
        , Phronesiser.ABI.Layout
        , Phronesiser.ABI.Foreign
        , Phronesiser.ABI.Proofs
